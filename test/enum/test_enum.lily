import (Interpreter,
        TestCase) "../t/testing"

class TestEnum < TestCase
{
    public define test_base
    {
        var t = Interpreter()

        # base (assign to class property)

        assert_parse_string(t, """
            class Test {
                public var @value: Option[String] = None
            }

            var v = Some(10)
            v = None

            var t = Test()
            t.value = Some("x")
        """)

        # base (Hash of variants)

        assert_parse_string(t, """
            var h: Hash[Integer, Option[Integer]] = [1 => None, 2 => Some(10), 3 => Some(11)]
        """)

        # base (vararg call)

        assert_parse_string(t, """
            define f[A](values: Option[A]...) {  }

            f(None, None, None)
            f(None, Some(10), None)
            f(Some(10), Some(10))
        """)
    }

    public define test_methods
    {
        var t = Interpreter()

        # methods (enum member function called on variant)

        assert_parse_string(t, """
            enum Test[A] {
                One(A),
                Two

                define or_else(other: A) : A {
                    match self: {
                        case One(s):
                            return s
                        case Two:
                            return other
                    }
                }
            }

            if Test.or_else(Test.One(1), 2) != 1: {
               raise Exception("Failed.")
            }
        """)
    }

    public define test_scope
    {
        var t = Interpreter()

        # Variant names are per-enum

        assert_parse_string(t, """
            enum SpeedOne {
                Fast,
                Medium,
                Slow
            }

            enum SpeedTwo {
                Fast,
                Medium,
                Slow
            }
        """)

        # Variant may have the same name as the enum

        assert_parse_string(t, """\
            enum check2 {
                check2,
                other
            }

            var w = check2.other

            match w: {
                case check2: 0
                case other: 0
            }

            var x = match w: {
                case check2: 0
                case other: 1
            }

            var y = x / x
        """)
    }

    public define test_shorthand
    {
        var t = Interpreter()

        # test shorthand (expression setup)
        assert_parse_string(t, """
            enum Speed {
                Slow,
                Medium,
                Fast
            }

            define check(:input input: Speed) {}
            define takemany[A](a: A, m: A...) {}
            define taketwo[A](a: A, b: A) {}
        """)

        # test shorthand (different calls)
        assert_parse_string(t, """
            check(.Slow)
            taketwo(Speed.Slow, .Medium)
            takemany(Speed.Slow, .Slow, .Medium)
        """)

        # test shorthand (assignments)
        assert_parse_string(t, """
            class Example {
                public var @x: Speed = .Fast
            }

            var v: Speed = .Fast

            define f {
                var w: Speed = .Fast
                var box: List[Speed] = [.Medium]

                box[0] = .Fast

                define g {
                    w = .Medium
                }
            }
        """)

        # test shorthand (return)
        assert_parse_string(t, """
            define g: Speed {
                return .Fast
            }
        """)

        # test shorthand (builders)
        assert_parse_string(t, """
            {
                var v2: List[Speed] = [.Fast, .Slow]
                var v3: Hash[Integer, Speed] = [1 => .Fast]
                var v4: Tuple[Speed] = <[.Fast]>
            }
        """)

        # test shorthand (practical nested usage)
        assert_parse_string(t, """
            enum Tree {
                Leaf(Integer),
                Branch(Tree, Tree)
            }

            define check2(t: Tree)
            {
                var v2 = t ++ ""

                if v2 != "Tree.Branch(Tree.Leaf(1), Tree.Leaf(2))": {
                    0 / 0
                }
            }

            check2(.Branch(.Leaf(1), Tree.Leaf(2)))
        """)
    }

    public define test_value_variants
    {
        var t = Interpreter()

        # test value variants (basic usage, numeric interpolation)
        assert_parse_string(t, """
            enum Direction < Integer {
                North,
                East = -2,
                South,
                West = 4567890
            }

            var directions = [.North, .East, .South, .West]
                                .@(List[Direction])
                                .map(|m| (m ++ "").parse_i().unwrap() )

            if directions != [0, -2, -1, 4567890]: {
                0 / 0
            }
        """)

        # test value variants (coerce to Integer)
        assert_parse_string(t, """
            var v: Integer = Direction.South

            directions = [Direction.North, Direction.East, Direction.South,
                          Direction.West]
                          .@(List[Integer])

            if v != -1 ||
               directions != [0, -2, -1, 4567890]: {
                0 / 0
            }
        """)

        # test value variants (variance)
        assert_parse_string(t, """
            enum LR < Integer {
                Left = 0,
                Right = 1
            }

            define x(a: Integer, b: Integer): Integer
            {
                if a != b: { 0/0 }
                return LR.Left
            }

            x(LR.Left, 0)
            x(LR.Right, 1)
        """)

        # test value variants (typecast narrowing)
        assert_parse_string(t, """
            define x2[A](a: A, b: A) { }

            x2(LR.Left.@(Integer), 0)
        """)

        # Allow math with value variants

        assert_parse_string(t, """
            enum Color < Integer {
                Red,
                Green,
                Blue,
            }

            if 1 + Color.Red != 1: {
                0/0
            }

            if Color.Red + Color.Green != (Color.Red + Color.Green): {
                0/0
            }

            if 1t + Color.Green != 2: {
                0/0
            }

            if Color.Blue * 0.5 != 1: {
                0/0
            }
        """)

        # They can be subscript indexes too

        assert_parse_string(t, """
            enum SubscriptDirection < Integer {
                North,
                East,
                South,
                West
            }

            if [1, 2, 3, 4][SubscriptDirection.East] != 2: {
                0/0
            }

            if B"abc"[SubscriptDirection.South] != 'c': {
                0/0
            }

            if "abc"[SubscriptDirection.North] != 'a': {
                0/0
            }
        """)

        # Inheriting Integer's methods as their own

        assert_parse_string(t, """
            if SubscriptDirection.North.to_s() != "0": {
                0/0
            }
        """)

        # These shouldn't clash since they have different casing
        # Not worth the effort to block

        assert_parse_string(t, """
            enum Example < Integer {
                abc,
                to_s
            }

            var example_x: Integer = Example.to_s
        """)
    }

    public define test_trailing_comma
    {
        var t = Interpreter()

        assert_parse_string(t, """
            enum Example {
                One,
                Two,
                Three,
            }

            enum ExampleB {
                BOne,
                BTwo,
                define f {}
            }

            enum ValueExample < Integer {
                First = 1,
                Second = 2,
                Third = 3,
            }

            enum ValueExampleB < Integer {
                BFirst = 1,
                BSecond = 2,
                define f {}
            }
        """)
    }
}
