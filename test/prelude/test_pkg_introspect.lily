import (ImportTarget,
        Interpreter,
        TestCase) "../t/testing", introspect

class TestPkgIntrospect < TestCase
{
    private var @t_class_payload =
        ImportTarget(
            :path "_class",
            :data """\
                ### Test docblock
                class Base
                {
                    ### Public method
                    public define pub(a: Integer...): String { return "" }

                    ### Public property
                    public var @pub_prop = 1

                    ### Protected property
                    protected var @pro_prop = ""

                    ### Private property
                    private var @pri_prop = 1.0
                }

                ### Some documentation
                class GenericClass[A, B](public var @test: String) < Base
                {
                    public define f[C](c: C) {}
                }
            """
        )

    private var @t_define_payload =
        ImportTarget(
            :path "_define",
            :data """\
                ### f docblock
                define f {}

                define g(a: Integer): String { return "" }

                define h(b: Double...) {}

                define i(c: *String="") {}

                define j(l: *Integer...=[]) {}
            """
        )

    private var @t_fake =
        ImportTarget(
            :kind .Package,
            :path "fake",
            :data """
                var v = 10
            """
        )

    private var @t_nest_example =
        ImportTarget(
            :path "nest\/example",
            :data """
                var v = 10
            """
        )

    public define test_class
    {
        var t = Interpreter.with_targets(
            @t_class_payload
        )

        t.config_set_extra_info(true)

        assert_parse_string(t, """
            import (SymScope, self) introspect
            import (Time) time
            import time
            import (Base) _class
            import _class

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_method(
                           m:         introspect.MethodEntry,
                :doc       doc:       String,
                :name      name:      String,
                :generics  generics:  String,
                :is_static is_static: Boolean,
                :line      line:      Integer,
                :params    params:    String,
                :scope     scope:     SymScope,
                :result    result:    String,
                :type      type:      String,
                :is_va     is_va:     Boolean
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    m.generics().map(|m_| m_.as_string() ).join(", "),
                    m.is_static(),
                    m.line_number(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string(),
                    m.is_varargs()
                ]>
                var expect = <[
                    doc,
                    name,
                    generics,
                    is_static,
                    line,
                    params,
                    scope,
                    result,
                    type,
                    is_va
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_property(
                           p:    introspect.PropertyEntry,
                :doc       doc:  String,
                :name      name: String,
                :scope     scope: SymScope,
                :type      type: String
            )
            {
                var input = <[
                    p.doc(),
                    p.name(),
                    p.scope(),
                    p.type().as_string()
                ]>
                var expect = <[
                    doc,
                    name,
                    scope,
                    type
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_class(
                          c:        introspect.ClassEntry,
                :doc      doc:      String,
                :foreign  foreign:  Boolean,
                :generics generics: String,
                :name     name:     String,
                :native   native:   Boolean,
                :parent   parent:   String,
                :props    props:    Integer
            )
            {
                var input = <[
                    c.doc(),
                    c.is_foreign(),
                    c.generics().map(|m| m.as_string() ).join(", "),
                    c.name(),
                    c.is_native(),
                    c.parent().map(|a| a.name() ).unwrap_or(""),
                    c.property_count()
                ]>
                var expect = <[
                    doc,
                    foreign,
                    generics,
                    name,
                    native,
                    parent,
                    props
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var mm = introspect.main_module()
            var class_m = mm.modules_used()[0]
            var classes = class_m.classes()

            {
                var c = classes[-1]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "Test docblock\\n",
                    :foreign  false,
                    :generics "",
                    :name     "Base",
                    :native   true,
                    :parent   "",
                    :props    3
                )

                check_method(
                    methods[-1],
                    :doc       "Test docblock\\n",
                    :generics  "",
                    :is_static false,
                    :line      3,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "Base",
                    :type      "Function ( => Base)",
                    :is_va     false
                )

                check_method(
                    methods[-2],
                    :doc       "Public method\\n",
                    :generics  "",
                    :is_static false,
                    :line      5,
                    :name      "pub",
                    :params    "(,Base,)(a,List[Integer],)",
                    :scope     .Public,
                    :result    "String",
                    :type      "Function (Base, Integer... => String)",
                    :is_va     true
                )

                check_property(
                    properties[-1],
                    :doc       "Public property\\n",
                    :name      "pub_prop",
                    :scope     .Public,
                    :type      "Integer"
                )

                check_property(
                    properties[-2],
                    :doc       "Protected property\\n",
                    :name      "pro_prop",
                    :scope     .Protected,
                    :type      "String"
                )

                check_property(
                    properties[-3],
                    :doc        "Private property\\n",
                    :name       "pri_prop",
                    :scope      .Private,
                    :type       "Double"
                )

                if methods.size() != 2 ||
                   properties.size() != 3: {
                    0 / 0
                }
            }
            {
                var c = classes[-2]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "Some documentation\\n",
                    :foreign  false,
                    :generics "A, B",
                    :name     "GenericClass",
                    :native   true,
                    :parent   "Base",
                    :props    4
                )

                check_method(
                    methods[-1],
                    :doc       "Some documentation\\n",
                    :generics  "A, B",
                    :is_static false,
                    :line      18,
                    :name      "<new>",
                    :params    "(,String,)",
                    :scope     .Public,
                    :result    "GenericClass[A, B]",
                    :type      "Function (String => GenericClass[A, B])",
                    :is_va     false
                )

                check_method(
                    methods[-2],
                    :doc       "",
                    :generics  "A, B, C",
                    :is_static false,
                    :line      20,
                    :name      "f",
                    :params    "(,GenericClass[A, B],)(c,C,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (GenericClass[A, B], C)",
                    :is_va     false
                )

                check_property(
                    properties[-1],
                    :doc        "",
                    :name       "test",
                    :scope     .Public,
                    :type       "String"
                )

                if methods.size() != 2 ||
                   properties.size() != 1: {
                    0 / 0
                }
            }

            class_m = mm.modules_used()[1]

            {
                var c = class_m.classes()[0]

                check_class(
                    c,
                    :doc      "",
                    :foreign  true,
                    :generics "",
                    :name     "Time",
                    :native   false,
                    :parent   "",
                    :props    0
                )
            }

            classes = mm.boxed_classes()

            {
                var c = classes[0]

                check_class(
                    classes[-2],
                    :doc      "Test docblock\\n",
                    :foreign  false,
                    :generics "",
                    :name     "Base",
                    :native   true,
                    :parent   "",
                    :props    3
                )
                check_class(
                    classes[-1],
                    :doc      "",
                    :foreign  true,
                    :generics "",
                    :name     "Time",
                    :native   false,
                    :parent   "",
                    :props    0
                )

                if classes.size() != 2: {
                    0 / 0
                }
            }
        """)
    }

    public define test_define
    {
        var t = Interpreter.with_targets(
            @t_define_payload
        )

        t.config_set_extra_info(true)

        assert_parse_string(t, """\
            import introspect
            import (g) _define
            import _define

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_define(
                           f:        introspect.FunctionEntry,
                :doc       doc:      String,
                :generics  generics: String,
                :line      line:     Integer,
                :name      name:     String,
                :params    params:   String,
                :result    result:   String,
                :type      type:     String,
                :is_va     is_va:    Boolean
            )
            {
                var input = <[
                    f.doc(),
                    f.generics().map(|m| m.as_string() ).join(", "),
                    f.line_number(),
                    f.name(),
                    stringify_parameters(f.parameters()),
                    f.result_type().as_string(),
                    f.type().as_string(),
                    f.is_varargs()
                ]>
                var expect = <[
                    doc,
                    generics,
                    line,
                    name,
                    params,
                    result,
                    type,
                    is_va
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var mm = introspect.main_module()
            var define_m = mm.modules_used()[0]
            var defines = define_m.functions()

            # Dump __module__ from the top.
            defines.pop()

            check_define(
                defines[-1],
                :doc        "f docblock\\n",
                :generics   "",
                :line       2,
                :name       "f",
                :params     "",
                :result     "Unit",
                :type       "Function ()",
                :is_va      false
            )

            check_define(
                defines[-2],
                :doc        "",
                :generics   "",
                :line       4,
                :name       "g",
                :params     "(a,Integer,)",
                :result     "String",
                :type       "Function (Integer => String)",
                :is_va      false
            )

            check_define(
                defines[-3],
                :doc        "",
                :generics   "",
                :line       6,
                :name       "h",
                :params     "(b,List[Double],)",
                :result     "Unit",
                :type       "Function (Double...)",
                :is_va      true
            )

            check_define(
                defines[-4],
                :doc        "",
                :generics   "",
                :line       8,
                :name       "i",
                :params     "(c,*String,)",
                :result     "Unit",
                :type       "Function (*String)",
                :is_va      false
            )

            check_define(
                defines[-5],
                :doc        "",
                :generics   "",
                :line       10,
                :name       "j",
                :params     "(l,*List[Integer],)",
                :result     "Unit",
                :type       "Function (*Integer...)",
                :is_va      true
            )

            if defines.size() != 5: {
                0 / 0
            }

            defines = mm.boxed_functions()

            check_define(
                defines[-1],
                :doc        "",
                :generics   "",
                :line       4,
                :name       "g",
                :params     "(a,Integer,)",
                :result     "String",
                :type       "Function (Integer => String)",
                :is_va      false
            )

            if defines.size() != 1: {
                0 / 0
            }
        """)
    }

    public define test_module
    {
        var t = Interpreter.with_targets(
            @t_nest_example,
            @t_fake
        )

        # module entry (setup)

        assert_parse_string(t, """
            import introspect
            import "nest/example"
            import fake
            import (Time) time

            define check_module(
                         m:       introspect.ModuleEntry,
                :dirname dirname: String,
                :doc     doc:     String,
                :name    name:    String,
                :path    path:    String
            )
            {
                var input = <[
                    m.dirname(),
                    m.doc(),
                    m.name(),
                    m.path()
                ]>
                var expect = <[
                    dirname,
                    doc,
                    name,
                    path
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var main_m = introspect.main_module()
            var modules = main_m.modules_used()

            {
                check_module(
                    modules[-3],
                    :dirname "packages\\/fake\\/src",
                    :doc     "",
                    :name    "fake",
                    :path    "packages\\/fake\\/src\\/fake.lily"
                )

                check_module(
                    modules[-2],
                    :dirname "",
                    :doc     "",
                    :name    "example",
                    :path    "nest\\/example.lily"
                )

                check_module(
                    modules[-1],
                    :dirname "",
                    :doc     "",
                    :name    "introspect",
                    :path    "[introspect]"
                )

                if modules.size() != 3: {
                    0 / 0
                }
            }
        """)
    }

    public define test_toplevel
    {
        var t = Interpreter()

        assert_parse_string(t, """
            import (Random) random
            import (Coroutine) coroutine
            import introspect

            define f(co: Coroutine[Integer, Unit]): Integer {
                return 0
            }

            define g(a: Integer...) {}

            {
                var result = [
                    1                  |> introspect.class_name,
                    1.0                |> introspect.class_name,
                    "1"                |> introspect.class_name,
                    '1'                |> introspect.class_name,
                    B"1"               |> introspect.class_name,
                    true               |> introspect.class_name,
                    [1]                |> introspect.class_name,
                    [1 => 1]           |> introspect.class_name,
                    <[1]>              |> introspect.class_name,
                    unit               |> introspect.class_name,
                    stdout             |> introspect.class_name,
                    Exception("")      |> introspect.class_name,
                    ValueError("")     |> introspect.class_name,
                    Coroutine.build(f) |> introspect.class_name,
                    Some(1)            |> introspect.class_name,
                    Random()           |> introspect.class_name,
                ]

                var expect = [
                    "Integer",
                    "Double",
                    "String",
                    "Byte",
                    "ByteString",
                    "Boolean",
                    "List",
                    "Hash",
                    "Tuple",
                    "Unit",
                    "File",
                    "Exception",
                    "ValueError",
                    "Coroutine",
                    "Some",
                    "Random",
                ]

                if result != expect: {
                    0 / 0
                }
            }

            var mm = introspect.main_module()
            var defines = mm.functions()

            # Drop __main__ from definitions.
            defines.pop()

            {
                var func_type = defines[-2].type()
                var id = func_type.class_id()
                var name = func_type.class_name()

                # The api does not guarantee that the id will be a specific
                # value, so don't test the value.
                # Instead, do this to make sure that the result is an Integer.

                if id < 0 || id.to_s().parse_i().unwrap() != id: {
                    0 / 0
                }

                if func_type.class_name() != "Function": {
                    0 / 0
                }

                if func_type.is_vararg_function() == false: {
                    0 / 0
                }

                var inner_types = func_type.inner_types()

                # Make sure this works for a non-Function value.

                if inner_types[1].is_vararg_function(): {
                    0 / 0
                }

                if inner_types[0].class_name() != "Unit" ||
                   inner_types[1].class_name() != "List" ||
                   inner_types.size() != 2: {
                    0 / 0
                }
            }
            {
                var func_type = defines[-1].type()

                if func_type.is_vararg_function(): {
                    0 / 0
                }
            }
            {
                var type = defines[-1].type()
                var p = introspect.ParameterEntry(
                    "test",
                    "example",
                    type
                )

                if p.name != "test" ||
                   p.keyword != "example" ||
                   p.type != type: {
                    0 / 0
                }
            }
            {
                # This covers calling generics when debug info is off.
                if defines[-1].generics().size(): {
                    0 / 0
                }
            }
        """)

        assert_parse_string(t, """
            var prelude_m = introspect.module_list()[0]
            var main_m = introspect.main_module()

            if prelude_m == main_m: {
                0/0
            }

            if prelude_m.id() == main_m.id(): {
                0/0
            }

            var id = prelude_m.id().to_s().parse_i().unwrap()

            if id != prelude_m.id(): {
                0/0
            }
        """)

        t = Interpreter.with_targets(
            @t_nest_example
        )

        assert_parse_string(t, """
            import introspect
            import "nest/example"

            define check_module(
                         m:       introspect.ModuleEntry,
                :dirname dirname: String,
                :doc     doc:     String,
                :name    name:    String,
                :path    path:    String
            )
            {
                var input = <[
                    m.dirname(),
                    m.doc(),
                    m.name(),
                    m.path()
                ]>
                var expect = <[
                    dirname,
                    doc,
                    name,
                    path
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var module_list = introspect.module_list()

            {
                check_module(
                    module_list[0],
                    :dirname "",
                    :doc     "",
                    :name    "prelude",
                    :path    "[prelude]"
                )
            }
        """)
    }

    public define test_enum_types_have_their_ids_fixed
    {
        var t = Interpreter()

        assert_parse_string(t, """\
            import introspect

            define f[A](a: A): Option[A] { return Some(a) }

            var m = introspect.main_module()
            var functions = m.functions()

            for func in functions: {
                if func.result_type().class_id() == 0: {
                    0 / 0
                }
            }
        """)
    }

    public define test_virt
    {
        var virt_data = """\
            class Base
            {
                forward public virtual define f { ... }
                protected virtual define g(a: String) {}
                private define h {}
            }
        """
        var t = Interpreter.with_targets(
            ImportTarget(
                :path "_virt",
                :data virt_data
            )
        )

        t.config_set_extra_info(true)

        assert_parse_string(t, """
            import _virt
            import introspect

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_method(
                           m:         introspect.MethodEntry,
                :doc       doc:       String,
                :name      name:      String,
                :generics  generics:  String,
                :is_static is_static: Boolean,
                :line      line:      Integer,
                :params    params:    String,
                :_         scope:     introspect.SymScope,
                :result    result:    String,
                :type      type:      String,
                :is_va     is_va:     Boolean,
                :_         is_forward: Boolean,
                :_         is_virt:   Boolean
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    m.generics().map(|m_| m_.as_string() ).join(", "),
                    m.is_static(),
                    m.line_number(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string(),
                    m.is_varargs(),
                    m.is_forward_virtual(),
                    m.is_virtual()
                ]>
                var expect = <[
                    doc,
                    name,
                    generics,
                    is_static,
                    line,
                    params,
                    scope,
                    result,
                    type,
                    is_va,
                    is_forward,
                    is_virt
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var m = introspect.main_module().modules_used()[-1]
            var methods = m.classes()[0].methods()

            {
                check_method(
                    methods[-1],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      2,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "Base",
                    :type      "Function ( => Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )

                check_method(
                    methods[-2],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      3,
                    :name      "f",
                    :params    "(,Base,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward true,
                    :is_virt    true
                )

                check_method(
                    methods[-3],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      4,
                    :name      "g",
                    :params    "(,Base,)(a,String,)",
                    :scope     .Protected,
                    :result    "Unit",
                    :type      "Function (Base, String)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    true
                )

                check_method(
                    methods[-4],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      5,
                    :name      "h",
                    :params    "(,Base,)",
                    :scope     .Private,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )
            }
        """)
    }

    public define test_scope_to_s
    {
        var t = Interpreter()

        assert_parse_string(t, """
            import (SymScope) introspect

            if SymScope.Public.as_string() != "public" ||
               SymScope.Protected.as_string() != "protected" ||
               SymScope.Private.as_string() != "private": {
                0/0
            }
        """)
    }

    public define test_docblock_whitespace
    {
        var t = Interpreter()

        t.config_set_extra_info(true)

        assert_parse_string(t, """
            ### ```lily
            ### for i in 1...5: {
            ###     print(i)
            ### }
            ### ```
            define example {}

            import introspect

            var fns = introspect.main_module().functions()
            var doc = fns[0].doc().split("\\n")
            var expect = [
                "```lily",
                "for i in 1...5: {",
                "    print(i)",
                "}",
                "```",
                "",
            ]

            if doc != expect: {
                0/0
            }
        """)
    }
}
