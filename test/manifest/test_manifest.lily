import (ImportTarget,
        Interpreter,
        TestCase) "../t/testing"

class TestManifest < TestCase
{
    private var @t_class_payload =
        ImportTarget(
            :path "_class",
            :data """\
                import manifest

                ### Test docblock
                class Base
                {
                    ### Public method
                    public define pub(a: Integer): String

                    ### Public property
                    public var @pub_prop: Integer

                    ### Protected property
                    protected var @pro_prop: String

                    ### Private property
                    private var @pri_prop: Double
                }

                class GenericClass[A, B](public var @test: String) < Base
                {
                    public define f[C](c: C)
                }

                ### ForeignBase docblock
                foreign class ForeignBase
                {
                    ### Public method
                    public define pub(a: Integer): String
                }

                foreign static class StaticBase
                {
                    public static define stat
                }
            """
        )

    private var @t_fake =
        ImportTarget(
            :kind .Package,
            :path "fake",
            :data """\
                import manifest

                ### Docblock for fake
                library fake
            """
        )

    private var @t_nest_example =
        ImportTarget(
            :path "nest\/example",
            :data """\
                import manifest

                ### Docblock for example
                library example
            """
        )

    private var @t_left =
        ImportTarget(
            :path "left",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_right =
        ImportTarget(
            :path "right",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_middle =
        ImportTarget(
            :path "middle",
            :data """\
                import manifest

                var v: Integer
            """
        )

    private var @t_check_forwards =
        ImportTarget(
            :path "check_forwards",
            :data """\
                import manifest

                forward class One { ... }
                forward class Two { ... }
                forward class Three { ... }
                forward class Four[A] { ... }

                enum Example[A] {
                    First(One),
                    Second(Two),
                    Third(Three),
                    Fourth(Four[A])
                }

                foreign class One {}
                class Two {}
                foreign static class Three {}
                class Four[A](a: A) {
                    protected var @pro_prop: String
                }
            """
        )

    private var @t_blank_optarg =
        ImportTarget(
            :path "blank_optarg",
            :data """\
                import manifest

                define f(a: *Integer, b: *String, c: *Double)
                define g(a: *Integer=1, b: *Function(*Double), c: *String="")
                define h(a: *Integer, b: *Option[Integer]=Some(1), c: *String)

                class Example {
                    public define i(a: *Integer=1, b: *Double=1.1, c: *Function(Integer))
                    public define j(a: *Integer, b: *Double=1.1, c: *String="")
                }
            """
        )

    private var @t_value_enum_payload =
        ImportTarget(
            :path "_value_enum",
            :data """\
                import manifest

                enum ValueDirection < Integer
                {
                    North,
                    East = -2,
                    South,
                    West = 4567890,
                    Test

                    define check
                }
            """
        )

    public define test_class
    {
        var t = Interpreter.with_targets(
            @t_class_payload
        )

        assert_manifest_string(t, """\
            import manifest
            import _class
        """)

        assert_parse_string(t, """\
            import introspect

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_method(
                           m:         introspect.MethodEntry,
                :doc       doc:       String,
                :name      name:      String,
                :generics  generics:  String,
                :is_static is_static: Boolean,
                :line      line:      Integer,
                :params    params:    String,
                :_         scope:     introspect.SymScope,
                :result    result:    String,
                :type      type:      String
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    m.generics().map(|m_| m_.as_string() ).join(", "),
                    m.is_static(),
                    m.line_number(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string()
                ]>
                var expect = <[
                    doc,
                    name,
                    generics,
                    is_static,
                    line,
                    params,
                    scope,
                    result,
                    type
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_property(
                           p:    introspect.PropertyEntry,
                :doc       doc:  String,
                :name      name: String,
                :_         scope: introspect.SymScope,
                :type      type: String
            )
            {
                var input = <[
                    p.doc(),
                    p.name(),
                    p.scope(),
                    p.type().as_string()
                ]>
                var expect = <[
                    doc,
                    name,
                    scope,
                    type
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_class(
                          c:        introspect.ClassEntry,
                :doc      doc:      String,
                :foreign  foreign:  Boolean,
                :generics generics: String,
                :name     name:     String,
                :native   native:   Boolean,
                :parent   parent:   String,
                :props    props:    Integer
            )
            {
                var input = <[
                    c.doc(),
                    c.is_foreign(),
                    c.generics().map(|m| m.as_string() ).join(", "),
                    c.name(),
                    c.is_native(),
                    c.parent().map(|a| a.name() ).unwrap_or(""),
                    c.property_count()
                ]>
                var expect = <[
                    doc,
                    foreign,
                    generics,
                    name,
                    native,
                    parent,
                    props
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var mm = introspect.main_module()
            var class_m = mm.modules_used()[1]
            var classes = class_m.classes()

            {
                var c = classes[-1]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "Test docblock\\n",
                    :foreign  false,
                    :generics "",
                    :name     "Base",
                    :native   true,
                    :parent   "",
                    :props    3
                )

                check_method(
                    methods[-1],
                    :doc       "Test docblock\\n",
                    :generics  "",
                    :is_static false,
                    :line      5,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "Base",
                    :type      "Function ( => Base)"
                )

                check_method(
                    methods[-2],
                    :doc       "Public method\\n",
                    :generics  "",
                    :is_static false,
                    :line      7,
                    :name      "pub",
                    :params    "(,Base,)(a,Integer,)",
                    :scope     .Public,
                    :result    "String",
                    :type      "Function (Base, Integer => String)"
                )

                check_property(
                    properties[-1],
                    :doc       "Public property\\n",
                    :name      "pub_prop",
                    :scope     .Public,
                    :type      "Integer"
                )

                check_property(
                    properties[-2],
                    :doc       "Protected property\\n",
                    :name      "pro_prop",
                    :scope     .Protected,
                    :type      "String"
                )

                check_property(
                    properties[-3],
                    :doc        "Private property\\n",
                    :name       "pri_prop",
                    :scope      .Private,
                    :type       "Double"
                )

                if methods.size() != 2 ||
                   properties.size() != 3: {
                    0 / 0
                }
            }
            {
                var c = classes[-2]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "",
                    :foreign  false,
                    :generics "A, B",
                    :name     "GenericClass",
                    :native   true,
                    :parent   "Base",
                    :props    4
                )

                check_method(
                    methods[-1],
                    :doc       "",
                    :generics  "A, B",
                    :is_static false,
                    :line      19,
                    :name      "<new>",
                    :params    "(,String,)",
                    :scope     .Public,
                    :result    "GenericClass[A, B]",
                    :type      "Function (String => GenericClass[A, B])"
                )

                check_method(
                    methods[-2],
                    :doc       "",
                    :generics  "A, B, C",
                    :is_static false,
                    :line      21,
                    :name      "f",
                    :params    "(,GenericClass[A, B],)(c,C,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (GenericClass[A, B], C)"
                )

                check_property(
                    properties[-1],
                    :doc        "",
                    :name       "test",
                    :scope      .Public,
                    :type       "String"
                )

                if methods.size() != 2 ||
                   properties.size() != 1: {
                    0 / 0
                }
            }
            {
                var c = classes[-3]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "ForeignBase docblock\\n",
                    :foreign  true,
                    :generics "",
                    :name     "ForeignBase",
                    :native   false,
                    :parent   "",
                    :props    0
                )

                check_method(
                    methods[-1],
                    :doc       "ForeignBase docblock\\n",
                    :generics  "",
                    :is_static false,
                    :line      26,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "ForeignBase",
                    :type      "Function ( => ForeignBase)"
                )

                check_method(
                    methods[-2],
                    :doc       "Public method\\n",
                    :generics  "",
                    :is_static false,
                    :line      28,
                    :name      "pub",
                    :params    "(,ForeignBase,)(a,Integer,)",
                    :scope     .Public,
                    :result    "String",
                    :type      "Function (ForeignBase, Integer => String)"
                )

                if methods.size() != 2 ||
                   properties.size() != 0: {
                    0 / 0
                }
            }
            {
                var c = classes[-4]
                var methods = c.methods()
                var properties = c.properties()

                check_class(
                    c,
                    :doc      "",
                    :foreign  true,
                    :generics "",
                    :name     "StaticBase",
                    :native   false,
                    :parent   "",
                    :props    0
                )

                check_method(
                    methods[-1],
                    :doc       "",
                    :generics  "",
                    :is_static true,
                    :line      33,
                    :name      "stat",
                    :params    "",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function ()"
                )

                if methods.size() != 1 ||
                   properties.size() != 0: {
                    0 / 0
                }
            }

            if classes.size() != 4: {
                0 / 0
            }
        """)
    }

    public define test_module
    {
        var t = Interpreter.with_targets(
            @t_nest_example,
            @t_fake
        )

        assert_manifest_string(t, """\
            import manifest
            import "nest/example"
            import fake
        """)

        assert_parse_string(t, """
            import introspect

            define check_module(
                         m:       introspect.ModuleEntry,
                :dirname dirname: String,
                :doc     doc:     String,
                :name    name:    String,
                :path    path:    String
            )
            {
                var input = <[
                    m.dirname(),
                    m.doc(),
                    m.name(),
                    m.path()
                ]>
                var expect = <[
                    dirname,
                    doc,
                    name,
                    path
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var main_m = introspect.main_module()
            var modules = main_m.modules_used()

            {
                check_module(
                    modules[-3],
                    :dirname "",
                    :doc     "",
                    :name    "introspect",
                    :path    "[introspect]"
                )

                check_module(
                    modules[-2],
                    :dirname "packages\\/fake\\/src",
                    :doc     "Docblock for fake\\n",
                    :name    "fake",
                    :path    "packages\\/fake\\/src\\/fake.lily"
                )

                check_module(
                    modules[-1],
                    :dirname "",
                    :doc     "Docblock for example\\n",
                    :name    "example",
                    :path    "nest\\/example.lily"
                )

                if modules.size() != 3: {
                    0 / 0
                }
            }
        """)
    }

    public define test_prelude
    {
        var t = Interpreter()

        # Load stdout so predefined manifest has to roll it back.
        assert_parse_string(t, "stdout")

        var result = t.parse_manifest_string("pkg_prelude",
        """\
            import manifest

            ### Prelude docblock
            library prelude

            predefined String {

            }

            predefined Option[A] {
                Some(A),
                None
            }

            predefined Result[A, B] {
                Failure(A),
                Success(B)
            }
        """)

        assert_equal(result, true)
    }

    public define test_import_diamond
    {
        var t = Interpreter.with_targets(
            @t_left,
            @t_right,
            @t_middle
        )

        assert_manifest_string(t, """\
            import manifest
            import left
            import right
        """)
    }

    public define test_keyword_forward
    {
        var t = Interpreter.with_targets(
            @t_check_forwards
        )

        assert_manifest_string(t, """\
            import manifest

            import check_forwards
        """)
    }

    public define test_blank_optarg
    {
        var t = Interpreter.with_targets(
            @t_blank_optarg
        )

        assert_manifest_string(t, """\
            import manifest

            import blank_optarg
        """)
    }

    public define test_value_variants
    {
        var t = Interpreter.with_targets(
            @t_value_enum_payload
        )

        assert_manifest_string(t, """\
            import manifest
            import _value_enum
        """)

        assert_parse_string(t, """\
            import introspect

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_value_enum(
                           e:         introspect.EnumEntry,
                :doc       doc:       String,
                :generics  generics:  String,
                :is_flat   is_flat:   Boolean,
                :is_scoped is_scoped: Boolean,
                :name      name:      String,
                :parent    parent:    String
            )
            {
                var input = <[
                    e.doc(),
                    e.generics().map(introspect.TypeEntry.as_string).join(", "),
                    e.is_flat(),
                    e.is_scoped(),
                    e.name(),
                    e.parent().map(introspect.ClassEntry.name).unwrap_or("")
                ]>
                var expect = <[
                    doc,
                    generics,
                    is_flat,
                    is_scoped,
                    name,
                    parent
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_enum_method(
                           m:      introspect.MethodEntry,
                :doc       doc:    String,
                :name      name:   String,
                :params    params: String,
                :_         scope:  introspect.SymScope,
                :result    result: String,
                :type      type:   String
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string()
                ]>
                var expect = <[
                    doc,
                    name,
                    params,
                    scope,
                    result,
                    type
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            define check_variant(
                           v:     introspect.VariantEntry,
                :enum_id   enum_id:   Integer,
                :enum_name enum_name: String,
                :is_empty  is_empty:  Boolean,
                :is_scoped is_scoped: Boolean,
                :params    params:    String,
                :name      name:      String,
                :type      type:      String,
                :value     value:     String
            )
            {
                var input = <[
                    v.enum_id(),
                    v.enum_name(),
                    v.is_empty(),
                    v.is_scoped(),
                    stringify_parameters(v.parameters()),
                    v.name(),
                    v.type().as_string(),
                    v.value()
                ]>
                var expect = <[
                    enum_id,
                    enum_name,
                    is_empty,
                    is_scoped,
                    params,
                    name,
                    type,
                    value
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var mm = introspect.main_module()
            var enum_m = mm.modules_used()[1]
            var enums = enum_m.enums()

            {
                var e = enums[-1]
                var methods = e.methods()
                var variants = e.variants()
                var id = e.id()

                check_value_enum(
                    e,
                    :doc      "",
                    :generics "",
                    :name     "ValueDirection",
                    :is_flat   true,
                    :is_scoped false,
                    :parent    "Integer"
                )

                check_enum_method(
                    methods[-1],
                    :doc        "",
                    :name       "check",
                    :params     "(,ValueDirection,)",
                    :scope      .Public,
                    :result     "Unit",
                    :type       "Function (ValueDirection)"
                )

                check_variant(
                    variants[-1],
                    :enum_id   e.id(),
                    :enum_name e.name(),
                    :is_empty  true,
                    :is_scoped false,
                    :name      "North",
                    :params    "",
                    :type      "ValueDirection",
                    :value     "0"
                )

                check_variant(
                    variants[-2],
                    :enum_id   e.id(),
                    :enum_name e.name(),
                    :is_empty  true,
                    :is_scoped false,
                    :name      "East",
                    :params    "",
                    :type      "ValueDirection",
                    :value     "-2"
                )

                check_variant(
                    variants[-3],
                    :enum_id   e.id(),
                    :enum_name e.name(),
                    :is_empty  true,
                    :is_scoped false,
                    :name      "South",
                    :params    "",
                    :type      "ValueDirection",
                    :value     "-1"
                )

                check_variant(
                    variants[-4],
                    :enum_id   e.id(),
                    :enum_name e.name(),
                    :is_empty  true,
                    :is_scoped false,
                    :name      "West",
                    :params    "",
                    :type      "ValueDirection",
                    :value     "4567890"
                )

                check_variant(
                    variants[-5],
                    :enum_id   e.id(),
                    :enum_name e.name(),
                    :is_empty  true,
                    :is_scoped false,
                    :name      "Test",
                    :params    "",
                    :type      "ValueDirection",
                    :value     "4567891"
                )

                if methods.size() != 1 ||
                   variants.size() != 5: {
                    0 / 0
                }
            }
        """)
    }

    public define test_virt
    {
        var virt_data = """\
            import manifest

            class Base
            {
                forward public virtual define f { ... }
                public virtual define g(a: String)
                public define h
            }
        """
        var t = Interpreter.with_targets(
            ImportTarget(
                :path "_virt",
                :data virt_data
            )
        )

        assert_manifest_string(t, """\
            import manifest
            import _virt
        """)

        assert_parse_string(t, """
            import (SymScope, self) introspect

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_method(
                           m:         introspect.MethodEntry,
                :doc       doc:       String,
                :name      name:      String,
                :generics  generics:  String,
                :is_static is_static: Boolean,
                :line      line:      Integer,
                :params    params:    String,
                :scope     scope:     SymScope,
                :result    result:    String,
                :type      type:      String,
                :is_va     is_va:     Boolean,
                :_         is_forward: Boolean,
                :_         is_virt:   Boolean
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    m.generics().map(|m_| m_.as_string() ).join(", "),
                    m.is_static(),
                    m.line_number(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string(),
                    m.is_varargs(),
                    m.is_forward_virtual(),
                    m.is_virtual()
                ]>
                var expect = <[
                    doc,
                    name,
                    generics,
                    is_static,
                    line,
                    params,
                    scope,
                    result,
                    type,
                    is_va,
                    is_forward,
                    is_virt
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var m = introspect.main_module().modules_used()[-1]
            var methods = m.classes()[0].methods()

            {
                check_method(
                    methods[-1],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      4,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "Base",
                    :type      "Function ( => Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )

                check_method(
                    methods[-2],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      5,
                    :name      "f",
                    :params    "(,Base,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward true,
                    :is_virt    true
                )

                check_method(
                    methods[-3],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      6,
                    :name      "g",
                    :params    "(,Base,)(a,String,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base, String)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    true
                )

                check_method(
                    methods[-4],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      7,
                    :name      "h",
                    :params    "(,Base,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )
            }
        """)
    }
}
