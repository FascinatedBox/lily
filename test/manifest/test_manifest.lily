import (ImportTarget,
        Interpreter,
        TestCase) "../t/testing"

class TestManifest < TestCase
{
    private var @t_fake =
        ImportTarget(
            :kind .Package,
            :path "fake",
            :data """\
                import manifest

                ### Docblock for fake
                library fake
            """
        )

    private var @t_nest_example =
        ImportTarget(
            :path "nest\/example",
            :data """\
                import manifest

                ### Docblock for example
                library example
            """
        )

    private var @t_left =
        ImportTarget(
            :path "left",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_right =
        ImportTarget(
            :path "right",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_middle =
        ImportTarget(
            :path "middle",
            :data """\
                import manifest

                var v: Integer
            """
        )

    private var @t_check_forwards =
        ImportTarget(
            :path "check_forwards",
            :data """\
                import manifest

                forward class One { ... }
                forward class Two { ... }
                forward class Three { ... }
                forward class Four[A] { ... }

                enum Example[A] {
                    First(One),
                    Second(Two),
                    Third(Three),
                    Fourth(Four[A])
                }

                foreign class One {}
                class Two {}
                foreign static class Three {}
                class Four[A](a: A) {
                    protected var @pro_prop: String
                }
            """
        )

    private var @t_blank_optarg =
        ImportTarget(
            :path "blank_optarg",
            :data """\
                import manifest

                define f(a: *Integer, b: *String, c: *Double)
                define g(a: *Integer=1, b: *Function(*Double), c: *String="")
                define h(a: *Integer, b: *Option[Integer]=Some(1), c: *String)

                class Example {
                    public define i(a: *Integer=1, b: *Double=1.1, c: *Function(Integer))
                    public define j(a: *Integer, b: *Double=1.1, c: *String="")
                }
            """
        )

    public define test_module
    {
        var t = Interpreter.with_targets(
            @t_nest_example,
            @t_fake
        )

        assert_manifest_string(t, """\
            import manifest
            import "nest/example"
            import fake
        """)

        assert_parse_string(t, """
            import introspect

            define check_module(
                         m:       introspect.ModuleEntry,
                :dirname dirname: String,
                :doc     doc:     String,
                :name    name:    String,
                :path    path:    String
            )
            {
                var input = <[
                    m.dirname(),
                    m.doc(),
                    m.name(),
                    m.path()
                ]>
                var expect = <[
                    dirname,
                    doc,
                    name,
                    path
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var main_m = introspect.main_module()
            var modules = main_m.modules_used()

            {
                check_module(
                    modules[-3],
                    :dirname "",
                    :doc     "",
                    :name    "introspect",
                    :path    "[introspect]"
                )

                check_module(
                    modules[-2],
                    :dirname "packages\\/fake\\/src",
                    :doc     "Docblock for fake\\n",
                    :name    "fake",
                    :path    "packages\\/fake\\/src\\/fake.lily"
                )

                check_module(
                    modules[-1],
                    :dirname "",
                    :doc     "Docblock for example\\n",
                    :name    "example",
                    :path    "nest\\/example.lily"
                )

                if modules.size() != 3: {
                    0 / 0
                }
            }
        """)
    }

    public define test_prelude
    {
        var t = Interpreter()

        # Load stdout so predefined manifest has to roll it back.
        assert_parse_string(t, "stdout")

        var result = t.parse_manifest_string("pkg_prelude",
        """\
            import manifest

            ### Prelude docblock
            library prelude

            predefined String {

            }

            predefined Option[A] {
                Some(A),
                None
            }

            predefined Result[A, B] {
                Failure(A),
                Success(B)
            }
        """)

        assert_equal(result, true)
    }

    public define test_import_diamond
    {
        var t = Interpreter.with_targets(
            @t_left,
            @t_right,
            @t_middle
        )

        assert_manifest_string(t, """\
            import manifest
            import left
            import right
        """)
    }

    public define test_keyword_forward
    {
        var t = Interpreter.with_targets(
            @t_check_forwards
        )

        assert_manifest_string(t, """\
            import manifest

            import check_forwards
        """)
    }

    public define test_blank_optarg
    {
        var t = Interpreter.with_targets(
            @t_blank_optarg
        )

        assert_manifest_string(t, """\
            import manifest

            import blank_optarg
        """)
    }

    public define test_virt
    {
        var virt_data = """\
            import manifest

            class Base
            {
                forward public virtual define f { ... }
                public virtual define g(a: String)
                public define h
            }
        """
        var t = Interpreter.with_targets(
            ImportTarget(
                :path "_virt",
                :data virt_data
            )
        )

        assert_manifest_string(t, """\
            import manifest
            import _virt
        """)

        assert_parse_string(t, """
            import (SymScope, self) introspect

            define stringify_parameters(p: List[introspect.ParameterEntry])
                : String
            {
                return p.map(|m| "({0},{1},{2})".format(
                    m.name,
                    m.type.as_string(),
                    m.keyword
                )).join()
            }

            define check_method(
                           m:         introspect.MethodEntry,
                :doc       doc:       String,
                :name      name:      String,
                :generics  generics:  String,
                :is_static is_static: Boolean,
                :line      line:      Integer,
                :params    params:    String,
                :scope     scope:     SymScope,
                :result    result:    String,
                :type      type:      String,
                :is_va     is_va:     Boolean,
                :_         is_forward: Boolean,
                :_         is_virt:   Boolean
            )
            {
                var input = <[
                    m.doc(),
                    m.function_name(),
                    m.generics().map(|m_| m_.as_string() ).join(", "),
                    m.is_static(),
                    m.line_number(),
                    stringify_parameters(m.parameters()),
                    m.scope(),
                    m.result_type().as_string(),
                    m.type().as_string(),
                    m.is_varargs(),
                    m.is_forward_virtual(),
                    m.is_virtual()
                ]>
                var expect = <[
                    doc,
                    name,
                    generics,
                    is_static,
                    line,
                    params,
                    scope,
                    result,
                    type,
                    is_va,
                    is_forward,
                    is_virt
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var m = introspect.main_module().modules_used()[-1]
            var methods = m.classes()[0].methods()

            {
                check_method(
                    methods[-1],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      4,
                    :name      "<new>",
                    :params    "",
                    :scope     .Public,
                    :result    "Base",
                    :type      "Function ( => Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )

                check_method(
                    methods[-2],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      5,
                    :name      "f",
                    :params    "(,Base,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward true,
                    :is_virt    true
                )

                check_method(
                    methods[-3],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      6,
                    :name      "g",
                    :params    "(,Base,)(a,String,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base, String)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    true
                )

                check_method(
                    methods[-4],
                    :doc       "",
                    :generics  "",
                    :is_static false,
                    :line      7,
                    :name      "h",
                    :params    "(,Base,)",
                    :scope     .Public,
                    :result    "Unit",
                    :type      "Function (Base)",
                    :is_va     false,
                    :is_forward false,
                    :is_virt    false
                )
            }
        """)
    }
}
