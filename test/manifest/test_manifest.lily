import (ImportTarget,
        Interpreter,
        TestCase) "../t/testing"

class TestManifest < TestCase
{
    private var @t_fake =
        ImportTarget(
            :kind .Package,
            :path "fake",
            :data """\
                import manifest

                ### Docblock for fake
                library fake
            """
        )

    private var @t_nest_example =
        ImportTarget(
            :path "nest\/example",
            :data """\
                import manifest

                ### Docblock for example
                library example
            """
        )

    private var @t_left =
        ImportTarget(
            :path "left",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_right =
        ImportTarget(
            :path "right",
            :data """\
                import manifest

                import middle
            """
        )

    private var @t_middle =
        ImportTarget(
            :path "middle",
            :data """\
                import manifest

                var v: Integer
            """
        )

    private var @t_check_forwards =
        ImportTarget(
            :path "check_forwards",
            :data """\
                import manifest

                forward class One { ... }
                forward class Two { ... }
                forward class Three { ... }
                forward class Four[A] { ... }

                enum Example[A] {
                    First(One),
                    Second(Two),
                    Third(Three),
                    Fourth(Four[A])
                }

                foreign class One {}
                class Two {}
                foreign static class Three {}
                class Four[A](a: A) {
                    protected var @pro_prop: String
                }
            """
        )

    private var @t_blank_optarg =
        ImportTarget(
            :path "blank_optarg",
            :data """\
                import manifest

                define f(a: *Integer, b: *String, c: *Double)
                define g(a: *Integer=1, b: *Function(*Double), c: *String="")
                define h(a: *Integer, b: *Option[Integer]=Some(1), c: *String)

                class Example {
                    public define i(a: *Integer=1, b: *Double=1.1, c: *Function(Integer))
                    public define j(a: *Integer, b: *Double=1.1, c: *String="")
                }
            """
        )

    public define test_module
    {
        var t = Interpreter.with_targets(
            @t_nest_example,
            @t_fake
        )

        assert_manifest_string(t, """\
            import manifest
            import "nest/example"
            import fake
        """)

        assert_parse_string(t, """
            import introspect

            define check_module(
                         m:       introspect.ModuleEntry,
                :dirname dirname: String,
                :doc     doc:     String,
                :name    name:    String,
                :path    path:    String
            )
            {
                var input = <[
                    m.dirname(),
                    m.doc(),
                    m.name(),
                    m.path()
                ]>
                var expect = <[
                    dirname,
                    doc,
                    name,
                    path
                ]>

                if input != expect: {
                    raise Exception("\\n    Expected: {0}\\n    Given: {1}"
                            .format(expect, input))
                }
            }

            var main_m = introspect.main_module()
            var modules = main_m.modules_used()

            {
                check_module(
                    modules[-3],
                    :dirname "",
                    :doc     "",
                    :name    "introspect",
                    :path    "[introspect]"
                )

                check_module(
                    modules[-2],
                    :dirname "packages\\/fake\\/src",
                    :doc     "Docblock for fake\\n",
                    :name    "fake",
                    :path    "packages\\/fake\\/src\\/fake.lily"
                )

                check_module(
                    modules[-1],
                    :dirname "",
                    :doc     "Docblock for example\\n",
                    :name    "example",
                    :path    "nest\\/example.lily"
                )

                if modules.size() != 3: {
                    0 / 0
                }
            }
        """)
    }

    public define test_prelude
    {
        var t = Interpreter()

        # Load stdout so predefined manifest has to roll it back.
        assert_parse_string(t, "stdout")

        var result = t.parse_manifest_string("pkg_prelude",
        """\
            import manifest

            ### Prelude docblock
            library prelude

            predefined String {

            }

            predefined Option[A] {
                Some(A),
                None
            }

            predefined Result[A, B] {
                Failure(A),
                Success(B)
            }
        """)

        assert_equal(result, true)
    }

    public define test_import_diamond
    {
        var t = Interpreter.with_targets(
            @t_left,
            @t_right,
            @t_middle
        )

        assert_manifest_string(t, """\
            import manifest
            import left
            import right
        """)
    }

    public define test_keyword_forward
    {
        var t = Interpreter.with_targets(
            @t_check_forwards
        )

        assert_manifest_string(t, """\
            import manifest

            import check_forwards
        """)
    }

    public define test_blank_optarg
    {
        var t = Interpreter.with_targets(
            @t_blank_optarg
        )

        assert_manifest_string(t, """\
            import manifest

            import blank_optarg
        """)
    }
}
