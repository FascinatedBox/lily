
#[
This file contains the content given to inspection.
Input content is parsed in default mode and in manifest mode.

Guidelines:
    Inputs are given to String.format, hence the {{ and }} escaping.
    {0} will be replaced with "import manifest" or "".
    {1} and above are for giving a value/define body/etc. (default mode).
    Inputs should end with f# to indicate how many values to send.
    \x22 is a double quote, since expected strings are fed as values.
    Direct sym input runs custom expects.
]#

constant constant_input_f6 =
"""\
{0}

### Constant docblock
constant one {1}
constant two {2}

### Doc for three
constant three {3}
constant four {4}
constant five {5}
"""

constant constant_expected =
"""\x22\x22\x22\
10 | constant five: ByteString
9 | constant four: Boolean
### Doc for three
8 | constant three: Double
5 | constant two: String
### Constant docblock
4 | constant one: Integer\
\x22\x22\x22"""

constant function_input_f5 =
"""\
{0}

### f docblock
define f {1}

define g(a: Integer): String {2}

define h(b: Double...) {1}

define i(c: *String{3}) {1}

define j(l: *Integer...{4}) {1}
"""

constant function_expected =
"""\x22\x22\x22\
12 | varargs define j(l: *List[Integer]): Unit
10 | define i(c: *String): Unit
8 | varargs define h(b: List[Double]): Unit
6 | define g(a: Integer): String
### f docblock
4 | define f(): Unit\
\x22\x22\x22"""

constant enum_input_f3 =
"""\
{0}

### FlatEnum docblock
enum FlatEnum
{{
    FlatOne,
    FlatTwo(Integer),
    FlatThree(String...),
    FlatFour(:a Integer, :b String)

    ### f docblock
    define f(:key a: Integer): Integer {1}

    define g {2}

    ### h docblock
    define h {2}
}}

scoped enum ScopedEnum[A, B]
{{
    ScopedOne(A),
    ScopedTwo(B),
    ScopedThree

    define f {2}
}}"""

constant enum_expected =
"""\x22\x22\x22\
enum ScopedEnum[A, B]
    ScopedThree
    ScopedTwo(B)
    ScopedOne(A)
    26 | public method f[A, B](ScopedEnum[A, B]): Unit
### FlatEnum docblock
enum FlatEnum
    FlatFour(:a Integer, :b String)
    FlatThree(List[String])
    FlatTwo(Integer)
    FlatOne
    ### h docblock
    17 | public method h(FlatEnum): Unit
    14 | public method g(FlatEnum): Unit
    ### f docblock
    12 | public method f(FlatEnum, :key a: Integer): Integer\
\x22\x22\x22"""

