
#[
This file contains the content given to inspection.
Input content is parsed in default mode and in manifest mode.
    (except m_* tests, which are manifest only)

Guidelines:
    Inputs are given to String.format, hence the {{ and }} escaping.
    {0} will be replaced with "import manifest" or "".
    {1} and above are for giving a value/define body/etc. (default mode).
    \x22 is a double quote, since expected strings are fed as values.
    Direct sym input runs custom expects.
]#

constant class_input_f =
"""\
{0}

### Test docblock
class Base
{{
    ### Public method
    public define pub(a: Integer): String {1}

    ### Public property
    public var @pub_prop {2}

    ### Protected property
    protected var @pro_prop {3}

    ### Private property
    private var @pri_prop {4}
}}

### Some documentation
class GenericClass[A, B](public var @test: String) < Base
{{
    public define f[C](c: C) {5}
}}
"""

constant class_expected =
"""\x22\x22\x22\
### Some documentation
class GenericClass[A, B] < Base | 4
    public property @test: String
    22 | public method f[A, B, C](GenericClass[A, B], c: C): Unit
    ### Some documentation
    20 | public method <new>[A, B](String): GenericClass[A, B]
### Test docblock
class Base | 3
    ### Private property
    private property @pri_prop: Double
    ### Protected property
    protected property @pro_prop: String
    ### Public property
    public property @pub_prop: Integer
    ### Public method
    7 | public method pub(Base, a: Integer): String
    ### Test docblock
    5 | public method <new>(): Base\
\x22\x22\x22"""

