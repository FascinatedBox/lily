"""\x22\x22\x22\
12 | varargs define j(l: *List[Integer]): Unit
10 | define i(c: *String): Unit
8 | varargs define h(b: List[Double]): Unit
6 | define g(a: Integer): String
### f docblock
4 | define f(): Unit\
\x22\x22\x22"""

constant enum_input_f =
"""\
{0}

### BasicEnum docblock
enum BasicEnum
{{
    One,
    Two(Integer),
    Three(String...),
    Four(:a Integer, :b String)

    ### f docblock
    define f(:key a: Integer): Integer {1}

    define g {2}

    ### h docblock
    define h {2}
}}

enum GenericEnum[A, B]
{{
    One(A),
    Two(B),
    Three

    define f {2}
}}"""

constant enum_expected =
"""\x22\x22\x22\
enum GenericEnum[A, B]
    Three
    Two(B)
    One(A)
    26 | public method f[A, B](GenericEnum[A, B]): Unit
### BasicEnum docblock
enum BasicEnum
    Four(:a Integer, :b String)
    Three(List[String])
    Two(Integer)
    One
    ### h docblock
    17 | public method h(BasicEnum): Unit
    14 | public method g(BasicEnum): Unit
    ### f docblock
    12 | public method f(BasicEnum, :key a: Integer): Integer\
\x22\x22\x22"""

