enum Tree {
    Value(String),
    Array(Tree...)

    define as_string: String {
        match self: {
            case Value(v):
                return v

            case Array(a):
                var result = "["
                var size = a.size() - 1

                for i in 0...size: {
                    result = "{}{}".format(result, a[i].as_string())
                    if i != size: {
                        result = result ++ " "
                    }
                }

                return result ++ "]"
        }
    }
}

stdout.write("Here's a JSON-like enum value as a string: ")
print(
        Tree.Array(
            .Array(
                .Value("abc"),
                .Value("def")
            ),
            .Value("1"),
            .Value("2"),
            .Array(
                .Array(
                    .Value("0")
                )
            )
        ).as_string()
    )
